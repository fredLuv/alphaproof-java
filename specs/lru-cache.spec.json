{
  "id": "oop-lru-cache",
  "title": "Classic Systems Design: Bounded O(1) LRU Cache",
  "description": "Demonstrates problem-agnostic formal proving via declarative .spec.json: structural interface/impl contracts, precondition checks, JSON oracle traces, and 250-step randomized differential model checking.",
  "hygiene": {
    "failOnWarnings": true,
    "minDeclaredTypes": 2,
    "forbidInstanceof": true
  },
  "roles": [
    {
      "name": "CACHE_INTERFACE",
      "kind": "interface_or_abstract",
      "nameHints": ["Cache", "ICache", "KeyValueCache"],
      "requiredMethods": ["get", "put", "size"]
    },
    {
      "name": "CACHE_IMPL",
      "kind": "concrete_class",
      "nameHints": ["LruCache", "LeastRecentlyUsedCache", "CacheImpl"],
      "subtypeOf": "CACHE_INTERFACE",
      "requiredMethods": ["get", "put", "size", "capacity"]
    }
  ],
  "oracleScenarios": [
    {
      "name": "BoundedCapacityTrace",
      "targetRole": "CACHE_IMPL",
      "constructorArgs": [2],
      "steps": [
        {"method": "capacity", "args": [], "expect": 2},
        {"method": "size", "args": [], "expect": 0},
        {"method": "put", "args": ["k1", "v1"]},
        {"method": "put", "args": ["k2", "v2"]},
        {"method": "size", "args": [], "expect": 2},
        {"method": "put", "args": ["k3", "v3"]},
        {"method": "size", "args": [], "expect": 2}
      ]
    }
  ],
  "theoremProbes": [
    {
      "name": "LruPreconditionsAndOracle",
      "stratum": "STRATUM_3_BEHAVIOR",
      "proposition": "Non-positive capacity rejected; get/put/recency eviction satisfy exact LRU semantics",
      "javaLines": [
        "import java.util.*;",
        "public final class {{PROBE_CLASS}} {",
        "  public static List<String> prove() {",
        "    List<String> errs = new ArrayList<>();",
        "    try {",
        "      new {{CACHE_IMPL}}<Integer, String>(0);",
        "      errs.add(\"Capacity 0 did not throw IllegalArgumentException\");",
        "    } catch (IllegalArgumentException expected) {}",
        "    try {",
        "      new {{CACHE_IMPL}}<Integer, String>(-3);",
        "      errs.add(\"Capacity -3 did not throw IllegalArgumentException\");",
        "    } catch (IllegalArgumentException expected) {}",
        "    {{CACHE_INTERFACE}}<Integer, String> cache = new {{CACHE_IMPL}}<>(2);",
        "    cache.put(1, \"A\");",
        "    cache.put(2, \"B\");",
        "    if (!Optional.of(\"A\").equals(cache.get(1))) errs.add(\"get(1) failed to return A\");",
        "    cache.put(3, \"C\");",
        "    if (cache.get(2).isPresent()) errs.add(\"Key 2 should have been evicted as LRU after get(1)\");",
        "    if (!Optional.of(\"C\").equals(cache.get(3))) errs.add(\"get(3) failed to return C\");",
        "    if (cache.size() != 2) errs.add(\"Expected size 2, got \" + cache.size());",
        "    return errs;",
        "  }",
        "}"
      ]
    },
    {
      "name": "DifferentialLruFuzz250",
      "stratum": "STRATUM_3_BEHAVIOR",
      "proposition": "forall 250 random (put/get/overwrite) operations across capacities {1,3,7}: impl == reference LRU model and size <= capacity",
      "javaLines": [
        "import java.util.*;",
        "public final class {{PROBE_CLASS}} {",
        "  public static List<String> prove() {",
        "    List<String> errs = new ArrayList<>();",
        "    Random rng = new Random(1337L);",
        "    for (int cap : new int[]{1, 3, 7}) {",
        "      {{CACHE_INTERFACE}}<Integer, String> dut = new {{CACHE_IMPL}}<>(cap);",
        "      Map<Integer, String> ref = new LinkedHashMap<>(cap, 0.75f, true) {",
        "        @Override protected boolean removeEldestEntry(Map.Entry<Integer, String> eldest) {",
        "          return size() > cap;",
        "        }",
        "      };",
        "      for (int step = 0; step < 250; step++) {",
        "        int key = rng.nextInt(cap * 2 + 2);",
        "        if (rng.nextBoolean()) {",
        "          String val = \"v\" + step;",
        "          dut.put(key, val);",
        "          ref.put(key, val);",
        "        } else {",
        "          Optional<String> actual = dut.get(key);",
        "          Optional<String> expected = Optional.ofNullable(ref.get(key));",
        "          if (!actual.equals(expected)) {",
        "            errs.add(\"Mismatch at cap=\" + cap + \" step=\" + step + \" key=\" + key + \": actual=\" + actual + \" expected=\" + expected);",
        "            return errs;",
        "          }",
        "        }",
        "        if (dut.size() != ref.size() || dut.size() > cap) {",
        "          errs.add(\"Size invariant violated at cap=\" + cap + \" step=\" + step + \": dut=\" + dut.size() + \" ref=\" + ref.size());",
        "          return errs;",
        "        }",
        "      }",
        "    }",
        "    return errs;",
        "  }",
        "}"
      ]
    }
  ]
}
